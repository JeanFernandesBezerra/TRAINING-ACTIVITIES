Algoritmo "semnome"

Var
nome : caractere
salario1 , salario2 : real
idade : inteiro


Inicio
escreval("Escreva seu nome: ")
leia(nome)
escreval
escreval("Escreva sua idade: ")
leia(idade)
escreval
escreval("Escreva seu salário mês passado")
leia(salario1)
escreval
escreval("Escreva seu salário do próximo mês")
leia(salario2)
escreval
escreval("Seu nome é: ",nome)
escreval("Sua idade é: ",idade)
escreval("Seu salário mês passado foi: ",salario1:1:2)
escreval("Seu salário próximo mês é: ",salario2:1:2)

Fimalgoritmo