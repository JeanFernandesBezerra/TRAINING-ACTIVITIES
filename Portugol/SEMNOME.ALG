Algoritmo "semnome"

Var
produto1, produto2, genero : caractere
preco1 , preco2 : real
codigo, idade : inteiro

Inicio
produto1 <- "computador"
produto2 <- "TV"
genero <- "F"
preco1 <- 642.437
preco2 <-  748.492
codigo <- 3841
idade <- 42

escreval("produtos:")
escreval("O produto ", produto1 ," custa ", preco1:1:2)
escreval("O produto ", produto2 ," custa ", preco2:1:2)
escreval
escreval("Código: ", codigo)
escreval
escreval("Dados da pessoa:")
escreval("gênero ", genero)
escreval("idade ", idade)
Fimalgoritmo