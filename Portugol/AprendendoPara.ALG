Algoritmo "semnome"

Var
quantidade, num, soma, x : inteiro

Inicio
escreva("quantidade de vezes : ")
leia(quantidade)

soma <- 0

para x de 1 ate quantidade faca
     escreva("Digite o número: ")
     leia(num)
     soma <- soma + num
     
fimpara

escreval("SOMA = ",soma)
escreva(x)
Fimalgoritmo