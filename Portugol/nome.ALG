Algoritmo "semnome"

Var
p1 , p2 : caracter
idade1 , idade2 : inteiro
media : real

Inicio
escreval("Dados da primeira pessoa:")
escreva("Nome: ")
leia(p1)
escreva("Idade: ")
leia(idade1)
escreval
escreval("Dados da segunda pessoa:")
escreva("Nome: ")
leia(p2)
escreva("Idade: ")
leia(idade2)

media <- (idade1+idade2)/2
escreval("A média das idade de ",p1," e ", p2," é de ", media," anos.")

escreva("oi")
leia(p1)
escreva("oie")

Fimalgoritmo