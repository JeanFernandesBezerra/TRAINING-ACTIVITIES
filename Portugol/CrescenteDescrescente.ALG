Algoritmo "semnome"

Var
x, y : real

Inicio

escreval("Digite dois números: ")
         leia(x)
         leia(y)
         se x > y entao
            escreval("DESCRESCENTE")
         senao
              se x < y entao
                 escreval("Crescente")
              fimse
         fimse

enquanto x <> y faca
         escreval("Digite dois números: ")
         leia(x)
         leia(y)
         se x > y entao
            escreval("DESCRESCENTE")
         senao
              se x < y entao
                 escreval("Crescente")
              fimse
         fimse
fimenquanto


Fimalgoritmo