Algoritmo "semnome"

Var
dinheirohora,trabalhohora,total : real
nome : caractere

Inicio
escreva("Nome: ")
leia(nome)
escreva("Dinheiro/hora: ")
leia(dinheirohora)
escreva("Horas trabalhadas: ")
leia(trabalhohora)
total <-(dinheirohora*trabalhohora)
escreva(nome," receberá R$",total)

Fimalgoritmo